DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Admite varios orígenes separados por coma, ej:
# CORS_ORIGIN=https://misionsiniestros.com.ar,https://www.misionsiniestros.com.ar
NODE_ENV=development

# Cloudinary (panel > Dashboard > Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# El código no depende de ningún proveedor: es SMTP genérico con nodemailer.
# Para pasar de mails de prueba a mails reales sólo hay que cambiar estas variables.
#
# Probar la config: npm run mail:test -- tu-mail@ejemplo.com
#
# IMPORTANTE: MAIL_FROM tiene que usar un dominio verificado en el proveedor
# (cargando los registros SPF/DKIM en el DNS de misionsiniestros.com.ar). Si mandás
# desde un dominio sin verificar, el proveedor rechaza el envío o el mail cae en spam.

# --- Activo: Brevo (300 mails/día gratis) ---
# Cómo conseguir SMTP_USER y SMTP_PASS:
#   1. Entrar a app.brevo.com > (ícono de la cuenta, arriba a la derecha) > SMTP & API
#   2. Pestaña "SMTP" > ahí figura el "Login" (SMTP_USER, algo como 8a1b2c001@smtp-brevo.com)
#   3. "Generate a new SMTP key" > copiar la key generada como SMTP_PASS (sólo se muestra una vez)
#   4. Antes de mandar mails reales: Senders, Domains & Dedicated IPs > Domains > agregar
#      misionsiniestros.com.ar y cargar los registros SPF/DKIM que Brevo indique en el DNS del dominio.
#      Sin esto, Brevo puede rechazar el envío o el mail cae en spam.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Alternativa: Resend (3.000 mails/mes gratis) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=          # API key de Resend (empieza con re_)

# --- Alternativa: Gmail (sólo para volumen bajo, ~500 mails/día) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=         # "contraseña de aplicación", NO la contraseña de la cuenta

# --- Desarrollo: Mailtrap (los mails quedan atrapados, no llegan a nadie) ---
# Email Testing > tu inbox > SMTP Settings > Node - Nodemailer
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=

MAIL_FROM=no-reply@misionsiniestros.com.ar
MAIL_FROM_NAME=Misión Siniestros
