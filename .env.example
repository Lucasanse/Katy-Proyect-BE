DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Cloudinary (panel > Dashboard > Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (código de verificación del paso 7). En desarrollo, usar las credenciales SMTP
# de un inbox de Mailtrap (Email Testing > tu inbox > SMTP Settings > Node - Nodemailer)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@misionsiniestros.com
