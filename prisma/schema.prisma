generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// TABLA DE ADMINISTRACIÓN (Privada)
// ------------------------------------------------------
model Administrador {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Aquí se guardará el hash (nunca la contraseña en texto)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// ESTADOS POSIBLES DE UN SINIESTRO
// ------------------------------------------------------
enum EstadoSiniestro {
  pendiente
  en_revision
  falta_documentacion
  presentado_compania
  cerrado
}

// ------------------------------------------------------
// TABLA PRINCIPAL: SINIESTRO
// ------------------------------------------------------
model Siniestro {
  id                Int             @id @default(autoincrement())
  fechaSiniestro    String
  horaSiniestro     String
  huboHeridos       Boolean         @default(false)
  lugarCalle        String
  lugarLocalidad    String
  lugarProvincia    String
  latitud           Float?
  longitud          Float?
  detallesAccidente String          @db.Text
  estado            EstadoSiniestro @default(pendiente)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relaciones
  titular           Titular?
  conductor         Conductor?
  productor         Productor?
  terceros          Tercero[]
  evidencias        Evidencia[]
}

// ------------------------------------------------------
// TABLAS HIJAS (Relación 1 a 1 con Siniestro)
// ------------------------------------------------------
model Titular {
  id            Int         @id @default(autoincrement())
  tipoDoc       String
  numDoc        String
  nombre        String
  apellido      String
  patente       String
  telefono      String
  email         String

  aseguradoraId Int
  aseguradora   Aseguradora @relation(fields: [aseguradoraId], references: [id], onDelete: Restrict)

  siniestroId   Int         @unique
  siniestro     Siniestro   @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
}

model Conductor {
  id             Int       @id @default(autoincrement())
  nombreCompleto String
  documento      String
  telefono       String?
  email          String?
  vinculo        String?
  siniestro      Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
  siniestroId    Int       @unique
}

model Productor {
  id          Int       @id @default(autoincrement())
  esProductor Boolean   @default(false)
  nombre      String?
  matricula   String?
  telefono    String?
  email       String?

  siniestroId Int       @unique
  siniestro   Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// TABLAS MÚLTIPLES (Relación 1 a Muchos con Siniestro)
// ------------------------------------------------------
model Tercero {
  id            Int          @id @default(autoincrement())
  dni           String?
  nombre        String?
  apellido      String?
  patente       String?

  aseguradoraId Int?
  aseguradora   Aseguradora? @relation(fields: [aseguradoraId], references: [id], onDelete: SetNull)

  siniestroId   Int
  siniestro     Siniestro    @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
}

model Evidencia {
  id            Int       @id @default(autoincrement())
  tipoDocumento String    // Ej: "foto_patente", "dni_frente", "daños_detalle"
  urlArchivo    String    // La URL entregada por Cloudinary
  publicId      String    // public_id de Cloudinary, necesario para poder borrar el archivo

  siniestroId   Int
  siniestro     Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// CATÁLOGO DE ASEGURADORAS (administrable por el panel)
// ------------------------------------------------------
model Aseguradora {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  telefono  String?
  email     String?
  sitioWeb  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titulares Titular[]
  terceros  Tercero[]
}